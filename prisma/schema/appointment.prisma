model Appointment {
  id                   String            @id @default(uuid())
  status               AppointmentStatus @default(PENDING)
  joiningTime          DateTime?
  recordUrl            String?
  recordPublicId       String?
  prescriptionUrl      String?
  prescriptionPublicId String?
  serialNumber         Int?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  payments             Payment?
  patientId            String
  patient              Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  doctorId String
  doctor   Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  scheduleId String
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([patientId, doctorId, scheduleId], name: "unique_appointment")
  @@unique([scheduleId, serialNumber, joiningTime], name: "unique_appointment_serial_number")
  @@map("appointments")
}
